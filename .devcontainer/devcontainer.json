// https://aka.ms/devcontainer.json
{
	"name": "Mon AFGES",
	"dockerComposeFile": [
		"../compose.yml"
	],
	"service": "laravel.test",
	"workspaceFolder": "/var/www/html",
	"customizations": {
		"vscode": {
			"extensions": [
				"laravel.vscode-laravel",
				"mikestead.dotenv",
				"amiralizadeh9480.laravel-extra-intellisense",
				"ryannaddy.laravel-artisan",
				"onecentlin.laravel5-snippets",
				"onecentlin.laravel-blade",
				"GitHub.copilot-chat",
				"csstools.postcss"
			],
			"settings": {}
		}
	},
	"remoteUser": "sail",
	"postCreateCommand": "composer setup",
//    "postAttachCommand": "composer dev",
	"forwardPorts": [8000, 5173, "mailpit:8025"],
	// "runServices": [],
	"shutdownAction": "stopCompose"
}
