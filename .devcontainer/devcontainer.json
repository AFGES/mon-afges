// https://aka.ms/devcontainer.json
{
	"name": "Mon AFGES",
	"dockerComposeFile": [
		"../compose.yml"
	],
	"service": "laravel.test",
	"workspaceFolder": "/var/www/html",
	"customizations": {
		"vscode": {
			"extensions": [
				"laravel.vscode-laravel",
				"mikestead.dotenv",
				"amiralizadeh9480.laravel-extra-intellisense",
				"ryannaddy.laravel-artisan",
				"onecentlin.laravel5-snippets",
				"onecentlin.laravel-blade",
				"GitHub.copilot-chat"
			],
			"settings": {}
		}
	},
	"remoteUser": "sail",
	"postCreateCommand": "chown -R 1000:1000 /var/www/html; composer run setup",
	"forwardPorts": [80, 5173, "mailpit:8025"]
	// "runServices": [],
	// "shutdownAction": "none",
}
