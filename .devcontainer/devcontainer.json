// https://aka.ms/devcontainer.json
{
	"name": "Mon AFGES",
	"dockerComposeFile": [
		"../compose.yml",
		"compose.podman.yml",
		"compose.ports.yml"
	],
	"service": "laravel.test",
	"workspaceFolder": "/var/www/html",
	"customizations": {
		"vscode": {
			"extensions": [
				"laravel.vscode-laravel",
				"mikestead.dotenv",
				"amiralizadeh9480.laravel-extra-intellisense",
				"ryannaddy.laravel-artisan",
				"onecentlin.laravel5-snippets",
				"onecentlin.laravel-blade",
				"GitHub.copilot-chat",
				"csstools.postcss",
                "hverlin.mise-vscode"
			],
			"settings": {}
		}
	},
	"features": {
        "ghcr.io/devcontainers-extra/features/mise:1": {}
	},
	"remoteUser": "sail",
	"postCreateCommand": {
		"mise": "mise trust --yes --all && mise install",
		"composer": "composer setup"
	},
	// "runServices": [],
	"shutdownAction": "stopCompose",
	"remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/share/mise/shims"
  },
	"mounts": [
        "source=${localEnv:HOME}/.claude,target=/home/sail/.claude,type=bind",
        "source=${localEnv:HOME}/.claude.json,target=/home/sail/.claude.json,type=bind"
	]
}
