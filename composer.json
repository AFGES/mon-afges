{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "afges/mon-afges",
    "type": "project",
    "description": "An app for manage democratic processes in AFGES",
    "keywords": [
        "democratic processes",
        "non profit organization"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "bezhansalleh/filament-shield": "^4.3.1",
        "dutchcodingcompany/filament-socialite": "^3.3",
        "filament/filament": "^5.10.2",
        "finity-labs/fin-mail": "^1.14",
        "google/apiclient": "^2.20.1",
        "jeffgreco13/filament-breezy": "^3.2.8",
        "laravel/framework": "^13.36",
        "laravel/octane": "^2.22",
        "laravel/tinker": "^3.0",
        "owenvoke/blade-fontawesome": "^3.3",
        "socialiteproviders/google": "^4.1",
        "ysfkaya/filament-phone-input": "^4.2"
    },
    "require-dev": {
        "carthage-software/mago": "^1.57",
        "fakerphp/faker": "^1.24.1",
        "filament/blueprint": "^2.4",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10.3",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.69",
        "laravel/telescope": "^5.26",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "recca0120/laravel-erd": "^0.6",
        "roave/security-advisories": "dev-latest",
        "spatie/boost-spatie-guidelines": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "lint:mago": [
            "mago lint"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=2G"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=filament-phone-input-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "repositories": [{
        "name": "filament",
        "type": "composer",
        "url": "https://packages.filamentphp.com/composer"
    }]
}
