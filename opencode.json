{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": ["php", "artisan", "boost:mcp"]
        }
    },
    "lsp": {
        "devsense": {
            "command": ["bunx", "devsense-php-ls"],
            "initialization": {
                "0": ""
            },
            "extensions": [".php"]
        }
    },
    "permission": {
        "*": "ask",
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "list": "allow",
        "lsp": "allow"
    }
}
