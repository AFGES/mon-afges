{
    "$schema": "https://opencode.ai/config.json",
    "model": "github-copilot/claude-sonnet-4.5",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    },
    "lsp": {
        "devsense": {
            "command": [
                "bunx",
                "devsense-php-ls"
            ],
            "initialization": [
                ""
            ],
            "extensions": [
                ".php"
            ]
        }
    },
    "permission": {
        "*": "ask",
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "list": "allow",
        "grep": "allow",
        "lsp": "allow",
        "codesearch": "allow",
        "todowrite": "allow",
        "todoread": "allow",
        "laravel-boost_*": "allow"
    }
}